actor "Técnico de Soporte" as Tecnico
actor "Empleado" as Empleado
rectangle "TechTrack Pro" {
  usecase "UC01 Registrar equipo" as UC01
  usecase "UC02 Asignar equipo" as UC02
  usecase "UC03 Registrar mantenimiento" as UC03
  usecase "UC04 Consultar asignados" as UC04
  usecase "UC05 Reporte mantenimiento" as UC05
  usecase "UC06 Dar de baja equipo" as UC06
  usecase "UC07 Actualizar usuario" as UC07
  usecase "UC08 Historial equipo" as UC08
}
Admin -- UC01
Admin -- UC02
Admin -- UC03
Admin -- UC04
Admin -- UC05
Admin -- UC06
Admin -- UC07
Admin -- UC08
